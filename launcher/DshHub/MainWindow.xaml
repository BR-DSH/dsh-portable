<Window x:Class="DshHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DshHub"
        Title="DeepSeek Harness 控制台"
        Width="540" Height="800"
        MinWidth="480" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBg}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Icon="pack://application:,,,/whale-256.png"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        AllowsTransparency="False"
        SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBg}"
            BorderBrush="#1B2230"
            BorderThickness="1"
            CornerRadius="0">
        <DockPanel>

            <!-- ============ Title bar ============ -->
            <Border DockPanel.Dock="Top" Height="52" Background="#12161F"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <!-- Whale logo tile (white bg, blue whale) -->
                        <Border Width="34" Height="34" CornerRadius="9" VerticalAlignment="Center"
                                Background="White" BorderBrush="#D6DDEC" BorderThickness="1">
                            <Viewbox Width="23" Height="23">
                                <Path Data="{StaticResource WhaleGeometry}" Fill="#4D6BFE" Stretch="Uniform" />
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="DeepSeek Harness" Foreground="{StaticResource TextPrimary}"
                                       FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="TitleVersionText" Text="控制台" Foreground="{StaticResource TextDim}"
                                       FontSize="10.5" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MinBtn" AutomationProperties.AutomationId="Minimize"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource TitleButton}" Click="Minimize_Click"
                                ToolTip="最小化" ToolTipService.ShowOnDisabled="True">
                            <Path Data="M0,0 L12,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" Margin="0,1,0,0" />
                        </Button>
                        <Button x:Name="CloseBtn" AutomationProperties.AutomationId="Close"
                                WindowChrome.IsHitTestVisibleInChrome="True"
                                Style="{StaticResource TitleButton}" Click="Close_Click" Margin="0,0,4,0"
                                ToolTip="关闭" ToolTipService.ShowOnDisabled="True">
                            <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Footer ============ -->
            <Border DockPanel.Dock="Bottom" Height="30" Background="#0B0E13"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0">
                <DockPanel Margin="14,0,14,0">
                    <TextBlock x:Name="FooterText" DockPanel.Dock="Left" Text="就绪"
                               Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="DSH Hub" Foreground="{StaticResource TextDim}"
                               FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right" />
                </DockPanel>
            </Border>

            <!-- ============ Content ============ -->
            <Grid Margin="18,16,18,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- status -->
                    <RowDefinition Height="Auto" />  <!-- actions -->
                    <RowDefinition Height="Auto" />  <!-- versions -->
                    <RowDefinition Height="Auto" />  <!-- quick links -->
                    <RowDefinition Height="*" />     <!-- log -->
                </Grid.RowDefinitions>

                <!-- ===== Status banner ===== -->
                <Border Grid.Row="0" Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12"
                        Padding="16,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                    MouseLeftButtonUp="Status_Click" Cursor="Hand"
                                    ToolTip="点击刷新状态" ToolTipService.ShowOnDisabled="True">
                            <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource GrayBrush}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock x:Name="StatusText" Text="正在检测…" Foreground="{StaticResource TextPrimary}"
                                           FontSize="15" FontWeight="SemiBold" />
                                <TextBlock x:Name="StatusDetail" Text="" Foreground="{StaticResource TextSecondary}"
                                           FontSize="11.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="BtnOpenUi" AutomationProperties.AutomationId="OpenUi" Grid.Column="2" Style="{StaticResource PrimaryButton}"
                                Padding="14,8" Click="OpenUi_Click" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="15" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Data="M1,5 L9,1 L17,5 L17,11 L9,15 L1,11 Z" Stroke="White" StrokeThickness="1.2"
                                          Stretch="Uniform" />
                                </Viewbox>
                                <TextBlock Text="打开界面" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ===== Action buttons ===== -->
                <UniformGrid Grid.Row="1" Columns="3" Margin="0,12,0,0">
                    <Button x:Name="BtnStart" AutomationProperties.AutomationId="Start" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0"
                            Click="Start_Click" Height="38">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,0 L10,5 L2,10 Z" Fill="White" Width="11" Height="11" Margin="0,0,7,0"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="启动服务" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnStop" AutomationProperties.AutomationId="Stop" Style="{StaticResource DangerButton}" Margin="3,0"
                            Click="Stop_Click" Height="38">
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="10" Height="10" Fill="#F79A9A" RadiusX="1.5" RadiusY="1.5"
                                       Margin="0,0,7,0" VerticalAlignment="Center" />
                            <TextBlock Text="停止服务" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRestart" AutomationProperties.AutomationId="Restart" Style="{StaticResource GhostButton}" Margin="6,0,0,0"
                            Click="Restart_Click" Height="38">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="15" Height="15" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Path Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4,7.58 4,12C4,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4Z"
                                      Fill="{StaticResource TextSecondary}" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="重启服务" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- ===== Version card ===== -->
                <Border Grid.Row="2" Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12"
                        Padding="16,14" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="版本信息" Foreground="{StaticResource TextPrimary}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock x:Name="UpdateHint" Text="" Foreground="{StaticResource TextDim}"
                                           FontSize="11" Margin="10,1,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button x:Name="BtnCheckUpdate" AutomationProperties.AutomationId="CheckUpdate" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Padding="12,6" Click="CheckUpdate_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="11" Height="11" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Path Data="M8,1 A7,7 0 1 1 1.5,5.5" Stroke="{StaticResource TextSecondary}"
                                              StrokeThickness="1.5" Stretch="Uniform" StrokeStartLineCap="Round" />
                                    </Viewbox>
                                    <TextBlock Text="检查更新" VerticalAlignment="Center" FontSize="12" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- version rows: label | local → latest | badge -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="96" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="核心引擎" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RowCoreVer" Grid.Row="0" Grid.Column="1" Style="{StaticResource MetaText}"
                                       Text="—" VerticalAlignment="Center" />
                            <Border x:Name="RowCoreBadge" Grid.Row="0" Grid.Column="2" CornerRadius="6" Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="RowCoreBadgeText" Text="" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Web UI 全家桶" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RowWebUiVer" Grid.Row="1" Grid.Column="1" Style="{StaticResource MetaText}"
                                       Text="—" VerticalAlignment="Center" />
                            <Border x:Name="RowWebUiBadge" Grid.Row="1" Grid.Column="2" CornerRadius="6" Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="RowWebUiBadgeText" Text="" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="dsh-doc 文档" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RowDocVer" Grid.Row="2" Grid.Column="1" Style="{StaticResource MetaText}"
                                       Text="—" VerticalAlignment="Center" />
                            <Border x:Name="RowDocBadge" Grid.Row="2" Grid.Column="2" CornerRadius="6" Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="RowDocBadgeText" Text="" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="OCR 运行时" Style="{StaticResource MetaText}" VerticalAlignment="Center" />
                            <TextBlock x:Name="RowOcrText" Grid.Row="3" Grid.Column="1" Style="{StaticResource MetaText}"
                                       Text="—" VerticalAlignment="Center" />
                            <Border x:Name="RowOcrBadge" Grid.Row="3" Grid.Column="2" CornerRadius="6" Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="RowOcrBadgeText" Text="" FontSize="10.5" FontWeight="SemiBold" />
                            </Border>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnUpdate" AutomationProperties.AutomationId="Update" Grid.Column="0" Style="{StaticResource PrimaryButton}"
                                    Padding="20,9" Click="Update_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,1 L9,6 L4,11 L4,8 L1,8 L1,4 L4,4 Z M10,3 L14,3 L14,11 L10,11 L10,8 L13,8 L13,6 L10,6 Z"
                                          Fill="White" Width="13" Height="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="立即更新" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="UpdateNote" Grid.Column="1" Text="更新前会自动备份，更新后请重新启动服务。"
                                       Foreground="{StaticResource TextDim}" FontSize="11" Margin="12,0,0,0"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== Quick links ===== -->
                <UniformGrid Grid.Row="3" Columns="3" Margin="0,12,0,0">
                    <Button Style="{StaticResource GhostButton}" Margin="0,0,6,0" Height="34" Click="OpenLogs_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Path Data="M2,1 L10,1 L14,5 L14,15 L2,15 Z" Stroke="{StaticResource TextSecondary}"
                                      StrokeThickness="1.3" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="打开日志" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="3,0" Height="34" Click="OpenBackups_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="13" Height="14" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Path Data="M2,1 L10,1 L14,5 L14,15 L2,15 Z" Stroke="{StaticResource TextSecondary}"
                                      StrokeThickness="1.3" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="打开备份" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Margin="6,0,0,0" Height="34" Click="OpenFolder_Click">
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="14" Height="13" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Path Data="M1,3 L5,3 L7,5 L15,5 L15,13 L1,13 Z" Stroke="{StaticResource TextSecondary}"
                                      StrokeThickness="1.3" Stretch="Uniform" />
                            </Viewbox>
                            <TextBlock Text="安装目录" VerticalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- ===== Log console ===== -->
                <Border Grid.Row="4" Background="{StaticResource CardBg}"
                        BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12"
                        Margin="0,12,0,0" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="14,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="运行日志" Foreground="{StaticResource TextPrimary}"
                                           FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock x:Name="LogCountText" Text="" Foreground="{StaticResource TextDim}"
                                           FontSize="10.5" Margin="8,2,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource GhostButton}" Padding="10,4" Height="24"
                                    Click="ClearLog_Click" VerticalAlignment="Center">
                                <TextBlock Text="清空" FontSize="11" />
                            </Button>
                        </Grid>
                        <Border Grid.Row="1" Background="{StaticResource LogBg}" BorderThickness="0,1,0,0"
                                BorderBrush="{StaticResource CardBorder}" CornerRadius="0,0,12,12">
                            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                          Padding="12,10" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="LogList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                                       FontFamily="Consolas, Microsoft YaHei UI" FontSize="11.5"
                                                       TextWrapping="Wrap" Margin="0,0,0,3" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
