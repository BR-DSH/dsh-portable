# =============================================================
#  DSH 便携发行仓库 .gitignore
#  约定：git 只放"骨架"（脚本/配置/锁文件/插件源码/启动器源码），
#        大体积载荷随 GitHub Release 资产分发，不入库。
# =============================================================

# ---- 大体积载荷（Release 资产，见 PORTABLE-RELEASE.md）----
/node/
/store/
/vendor/
/dsh-home/runtimes/
DshDesktop.exe
*.zip
*.7z

# ---- pnpm 重建产物 ----
app-npm/node_modules/
dsh-home/profiles/node_modules/
dsh-home/profiles/*/node_modules/

# ---- 密钥（绝不入库）----
app-npm/.env
**/.env
!.env.example
dsh-home/.credentials.yaml

# ---- 本机运行态数据（各机器独立）----
dsh-home/sessions/
dsh-home/storages/
dsh-home/attachments/
dsh-home/webview2-data/
dsh-home/skin-center/
dsh-home/skins/
dsh-home/task-board/
dsh-home/dsh-usage/
dsh-home/dsh-session-archive/
dsh-home/llm-deepseek/
dsh-home/.repair-backups/
dsh-home/.anonymous-user-id
dsh-home/pet.json
dsh-home/profiles/web/.dsh-module-fallback
dsh-home/profiles/web/cordis.patch.yml.bak-plugin-manager

# ---- 运行产物 ----
logs/
backups/
dsh.pid
*.invalid-*

# ---- 编辑器 / 系统 ----
Thumbs.db
Desktop.ini
*.tmp
