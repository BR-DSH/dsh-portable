# DeepSeek Harness 环境配置
# 1. 在 https://platform.deepseek.com 申请 API Key
# 2. 把下面的 DEEPSEEK_API_KEY 改成你的 key
# 3. 保存后重新运行 start-dsh.bat（脚本会自动读取此文件）

DEEPSEEK_API_KEY=

# Ollama's OpenAI-compatible endpoint ignores the value; Harness requires it
# only because the OpenAI protocol adapter expects a non-empty credential.
OLLAMA_API_KEY=ollama

# 可选：自定义 API 地址，默认使用 DeepSeek 官方公开 API
# DEEPSEEK_BASE_URL=https://api.deepseek.com
